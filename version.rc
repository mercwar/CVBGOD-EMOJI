#include <windows.h>

// Icon resource definition (ID 100)
100 ICON "favicon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS   VS_FF_DEBUG
#else
    FILEFLAGS   0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode charset
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Mercwar"
            VALUE "FileDescription",  "AVIS Neon Emoji Clipboard"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "CVBGOD-FREE-EMOJI"
            VALUE "LegalCopyright",   "Copyright (C) 2026 CVBGOD. All rights reserved."
            VALUE "OriginalFilename", "CVBGOD-EMOJI.exe"
            VALUE "ProductName",      "All of THEE Emoji"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END